{
  "name": "aris-portfolio",
  "version": "1.0.0",
  "private": true,
  "description": "A cinematic, scroll-driven portfolio template for video editors. Next.js, GSAP, Lenis and hand-written WebGL.",
  "license": "MIT",
  "scripts": {
    "dev": "next dev --turbopack -H 0.0.0.0",
    "build": "next build",
    "start": "npx --yes serve@14 out -l 3000",
    "preview": "next build && npx --yes serve@14 out -l 3000",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "gsap": "^3.15.1",
    "lenis": "^1.3.27",
    "next": "^16.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "sass": "^1.108.1",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=20.9"
  }
}
